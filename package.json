{
  "name": "videomanager",
  "version": "0.1.0",
  "description": "离线本地图片与视频管理工作台",
  "author": "VideoManager",
  "license": "GPL-3.0-only",
  "private": true,
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "tsc --noEmit && electron-vite build",
    "start": "electron .",
    "test": "vitest run",
    "test:e2e": "node scripts/e2e.mjs",
    "build:native": "powershell -ExecutionPolicy Bypass -File scripts/build-native.ps1",
    "dist": "npm run build && electron-builder --win nsis --x64",
    "pack": "npm run build && electron-builder --win --dir --x64",
    "test:performance": "vitest run tests/performance.test.ts",
    "test:cross-volume": "node scripts/cross-volume.mjs"
  },
  "build": {
    "appId": "local.videomanager.desktop",
    "productName": "VideoManager",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "package.json",
      "!node_modules/better-sqlite3/prebuilds/{linux*,darwin*,win32-arm64*}"
    ],
    "asarUnpack": [
      "**/*.node"
    ],
    "extraResources": [
      {
        "from": "native/bin",
        "to": "native",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "docs/THIRD-PARTY-NOTICES.md",
        "to": "THIRD-PARTY-NOTICES.md"
      },
      {
        "from": "LICENSE",
        "to": "LICENSE.txt"
      }
    ],
    "npmRebuild": false,
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "VideoManager-${version}-Windows-x64-Setup.${ext}",
      "icon": "build/icon.ico",
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": true,
      "shortcutName": "VideoManager"
    },
    "electronDist": "node_modules/electron/dist"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "22.20.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/yauzl": "3.4.0",
    "@types/yazl": "3.3.1",
    "@vitejs/plugin-react": "4.7.0",
    "electron": "44.4.1",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "playwright": "1.61.1",
    "typescript": "7.0.2",
    "vite": "6.4.3",
    "vitest": "5.0.1"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-dropdown-menu": "2.1.24",
    "@radix-ui/react-popover": "1.1.23",
    "@tanstack/react-query": "5.103.1",
    "@tanstack/react-virtual": "3.14.13",
    "ajv": "8.20.0",
    "better-sqlite3": "13.0.3",
    "cordis": "4.0.0-rc.10",
    "lucide-react": "1.47.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "0.35.4",
    "yauzl": "3.4.0",
    "yazl": "3.3.1",
    "zod": "4.6.5",
    "zustand": "5.0.15"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
